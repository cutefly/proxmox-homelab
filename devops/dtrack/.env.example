# Dependency-Track Version
DTRACK_VERSION=4.11.7

# Host Port Mapping
# Web Frontend Port (Default: 8081)
PORT_FRONTEND=8081
# Backend API Server Port (Default: 8080)
PORT_BACKEND=8080

# PostgreSQL Database Configuration
POSTGRES_DB=dtrack
POSTGRES_USER=dtrack
POSTGRES_PASSWORD=ChangeThisPassword123!

# Frontend Public API URL (Accessible by user's browser)
# Example: https://dtrack.club012.com/api
API_BASE_URL=https://dtrack.club012.com/api

# API Server JVM Options (Memory optimization)
EXTRA_JVM_ARGUMENTS=-Xms2g -Xmx4g
