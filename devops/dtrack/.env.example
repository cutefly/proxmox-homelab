# Dependency-Track Version
DTRACK_VERSION=5.2.0

# Host Port Mapping
# Web Frontend Port (Default: 8081)
PORT_FRONTEND=8081
# Backend API Server Port (Default: 8080)
PORT_BACKEND=8080

# PostgreSQL Database Configuration
POSTGRES_DB=dtrack
POSTGRES_USER=dtrack
POSTGRES_PASSWORD=dtrack

# Frontend Public API URL (Accessible by user's browser)
# Example: https://dtrack.club012.com/api
API_BASE_URL=https://dtrack.club012.com

# API Server JVM Options (Memory optimization for apiserver container)
EXTRA_JAVA_OPTIONS=-Xms2g -Xmx4g

# OIDC Configuration for Dependency-Track
# Enable OIDC Authentication (true/false)
ALPINE_OIDC_ENABLED=true
# OIDC Client ID (must match the client ID configured in your OIDC provider)
ALPINE_OIDC_CLIENT_ID=dependency-track
# OIDC Issuer URL (the base URL of your OIDC provider)
ALPINE_OIDC_ISSUER=https://keycloak.club012.com/auth/realms/dependency-track
